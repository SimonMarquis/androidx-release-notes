    {
      "group": "test",
      "id": "core",
      "name": "Core",
      "version": "1.4.1-alpha03",
      "url": "https://developer.android.com/jetpack/androidx/releases/test#core-1.4.1-alpha03",
      "html": "<p><strong>Bug fixes</strong></p>\n<ul>\n <li>Fix visibility of View.captureToBitmap and Window.captureRegionToBitmap extensions</li>\n <li>Add clearer exception handling to Bitmap.writeToTestStorage and screenshot methods</li>\n</ul>",
