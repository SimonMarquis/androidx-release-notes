    {
      "id": "compose-compiler",
      "name": "Compose Compiler",
      "version": "1.4.8",
      "url": "https://developer.android.com/jetpack/androidx/releases/compose-compiler#1.4.8",
      "detailsHtml": "<p><strong>New Features</strong></p>\n<ul>\n <li>Target Kotlin compiler version is bumped to 1.8.22.</li>\n</ul>\n<p><strong>Bug Fixes</strong></p>\n<ul>\n <li>Improved error message for <code>@Composable</code> overrides. Now it correctly points out annotation mismatch.</li>\n <li>Warn about redundant <code>@Composable</code> annotation on inline lambdas that should not be marked as composable. This feature will not be supported with K2 compiler.</li>\n</ul>",
      "commitsUrl": "https://android.googlesource.com/platform/frameworks/support/+log/2fe7d40c0deea40f58e95e1e709fc55c5d5ad477..a0c8102678bd6a0e2f5cf2df3d220b4fe85cba5e/compose/compiler"
    },
    {
      "id": "compose-foundation",
      "name": "Compose Foundation",
      "version": "1.5.0-beta03",
      "url": "https://developer.android.com/jetpack/androidx/releases/compose-foundation#1.5.0-beta03",
