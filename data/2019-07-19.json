    },
    {
      "id": "navigation",
      "name": "Navigation",
      "version": "2.1.0-beta02",
      "url": "https://developer.android.com/jetpack/androidx/releases/navigation#2.1.0-beta02",
      "detailsHtml": "<strong>Note:</strong><span> This version is dependent on the Java 8 programming language. Please read <a href=\"https://developer.android.com/studio/write/java8-support\">Use Java 8 language features</a> to learn how to use it in your project.</span> \n<p><strong>Bug fixes</strong></p>\n<ul>\n <li>Removed unintentional jacoco dependency that was introduced in <code>2.1.0-beta01</code>. (<a href=\"https://issuetracker.google.com/issues/137782950\">b/137782950</a>)</li>\n</ul>",
      "commitsUrl": "https://android.googlesource.com/platform/frameworks/support/+log/e08a521e6ca90dc09329823c31c733d69a1164cf..ec4f7aa322b7f2b5aa14aff6dca9475b0df1345c/navigation"
