      "detailsHtml": "<p><strong>Bug Fixes</strong></p>\n<ul>\n <li>Release to support <a href=\"https://developer.android.com/jetpack/androidx/releases/camera#camera-core-1.0.0-beta10\">Camera-Core 1.0.0-beta10</a></li>\n</ul>",
