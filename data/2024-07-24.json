    {
      "id": "wear-protolayout",
      "name": "Wear ProtoLayout",
      "version": "1.2.0-rc01",
      "url": "https://developer.android.com/jetpack/androidx/releases/wear-protolayout#1.2.0-rc01",
      "detailsHtml": "<p><strong>Bug Fixes</strong></p>\n<ul>\n <li>We have fixed the standard Material Chip so it can be used as an icon only if none of the primary or secondary label is passed in. (<a href=\"https://android-review.googlesource.com/#/q/Iceef99c5f276878e544547b66eefb20e97334b10\">Iceef9</a>)</li>\n <li>Documentation for Material layouts has been updated to include <a href=\"https://developer.android.com/design/ui/wear/guides/surfaces/tiles-layouts#layout-templates\">visuals</a> from the relevant page for easier understanding of layouts. (<a href=\"https://android-review.googlesource.com/#/q/I0256ae5900343da270b5bc0c8a27b807a92f9f84\">I0256a</a>)</li>\n</ul>",
      "commitsUrl": "https://android.googlesource.com/platform/frameworks/support/+log/56579bc30499ce39f0d7a6713a065b00c6194206..a90014340290143c500c38a4029aea80a9a45c05/wear"
